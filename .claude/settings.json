{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Edit",
      "NotebookEdit",
      "Write",
      "Skill",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [],
    "ask": [
      "Bash"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "praxis@praxis": true
  }
}
